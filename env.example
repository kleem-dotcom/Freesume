# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_webhook_secret

# Auth/session signing
ENTITLEMENT_SECRET=choose_a_long_random_entitlement_secret

# PostgreSQL / Supabase
# Put the full connection string in your hosting provider's secret manager.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
